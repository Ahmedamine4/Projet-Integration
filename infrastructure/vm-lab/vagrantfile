VM1_IP = "192.168.56.10"
VM2_IP = "192.168.56.11"
VM3_IP = "192.168.56.12"
VM4_IP = "192.168.56.13"

# Shell snippet reused on both VMs
INSTALL_ANSIBLE = <<-SHELL
  apt-get update -qq
  apt-get install -y -qq ansible
SHELL

Vagrant.configure("2") do |config|

  config.vm.box              = "ubuntu/jammy64"
  config.vm.box_check_update = false
  config.vm.boot_timeout = 600
  
  # VM1 - Monitoring
  config.vm.define "vm1" do |vm1|
    vm1.vm.hostname = "vm1"

    vm1.vm.network "private_network", ip: VM1_IP

    vm1.vm.provider "virtualbox" do |vb|
      vb.name = "vm1"
      vb.memory = 2048
      vb.cpus = 2
      vb.gui = false
    end

    vm1.vm.synced_folder "./ansible", "/ansible", type: "virtualbox"

    vm1.vm.provision "shell", inline: INSTALL_ANSIBLE

    vm1.vm.provision "ansible_local" do |ansible|
      ansible.install = false
      ansible.playbook = "/ansible/playbook.yml"
      ansible.compatibility_mode = "2.0"
      ansible.extra_vars = {
        vm_role: "vm1",
        vm1_ip:  VM1_IP,
        vm2_ip:  VM2_IP,
        vm3_ip:  VM3_IP,
        vm4_ip:  VM4_IP
      }
    end
  end

  # VM2 
  config.vm.define "vm2" do |vm2|
    vm2.vm.hostname = "vm2"
    vm2.vm.network "private_network", ip: VM2_IP
    
    vm2.vm.provider "virtualbox" do |vb|
      vb.name   = "vm2"
      vb.memory = 2048
      vb.cpus   = 2
    end

    vm2.vm.synced_folder "./ansible", "/ansible"

    # install Ansible from Ubuntu's default repo (no PPA, no timeout)
    vm2.vm.provision "shell", inline: INSTALL_ANSIBLE

    # run playbook (install: false skips the broken PPA logic)
    vm2.vm.provision "ansible_local" do |ansible|
      ansible.install    = false
      ansible.playbook   = "/ansible/playbook.yml"
      ansible.compatibility_mode = "2.0"
      ansible.extra_vars = {
        vm_role: "vm2",
        vm1_ip:  VM1_IP,
        vm2_ip:  VM2_IP,
        vm3_ip:  VM3_IP,
        vm4_ip:  VM4_IP
      }
    end
  end

  # VM3 
  config.vm.define "vm3" do |vm3|
    vm3.vm.hostname = "vm3"
    vm3.vm.network "private_network", ip: VM3_IP

    vm3.vm.provider "virtualbox" do |vb|
      vb.name   = "vm3"
      vb.memory = 1024
      vb.cpus   = 1
    end

    vm3.vm.synced_folder "./ansible", "/ansible"

    vm3.vm.provision "shell", inline: INSTALL_ANSIBLE

    vm3.vm.provision "ansible_local" do |ansible|
      ansible.install    = false
      ansible.playbook   = "/ansible/playbook.yml"
      ansible.compatibility_mode = "2.0"
      ansible.extra_vars = {
        vm_role: "vm3",
        vm1_ip:  VM1_IP,
        vm2_ip:  VM2_IP,
        vm3_ip:  VM3_IP,
        vm4_ip:  VM4_IP
      }
    end
  end

  # VM4
  config.vm.define "vm4" do |vm4|
    vm4.vm.hostname = "vm4"
    vm4.vm.network "private_network", ip: VM4_IP

    vm4.vm.provider "virtualbox" do |vb|
      vb.name   = "vm4"
      vb.memory = 4096
      vb.cpus   = 3
    end

    vm4.vm.synced_folder "./ansible", "/ansible"

    vm4.vm.provision "shell", inline: INSTALL_ANSIBLE

    vm4.vm.provision "ansible_local" do |ansible|
      ansible.install    = false
      ansible.playbook   = "/ansible/playbook.yml"
      ansible.compatibility_mode = "2.0"
      ansible.extra_vars = {
        vm_role: "vm4",
        vm1_ip:  VM1_IP,
        vm2_ip:  VM2_IP,
        vm3_ip:  VM3_IP,
        vm4_ip:  VM4_IP
      }
    end
  end


end
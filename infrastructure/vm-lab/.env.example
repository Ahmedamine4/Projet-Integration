# PostgreSQL configuration
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb

# Prisma URL
# Docker Compose example:
DATABASE_URL="postgresql://postgres:change_me@db:5432/appdb?schema=public"

# Local backend outside Docker example:
# DATABASE_URL="postgresql://postgres:change_me@localhost:5432/appdb?schema=public"

# Express server port
PORT=3000

# Supabase configuration
# Get these values from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Token configuration
JWT_EXPIRES_IN=2h
JWT_SECRET=change_me_jwt_secret

# Refresh token configuration
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# AI service URL
# Docker Compose:
AI_API_URL=http://ai:8000

# Local backend outside Docker:
# AI_API_URL=http://localhost:8000

# Docker Desktop host access, only if AI runs on the host from inside a container:
# AI_API_URL=http://host.docker.internal:8000

NODE_ENV='development' # 'production' en production
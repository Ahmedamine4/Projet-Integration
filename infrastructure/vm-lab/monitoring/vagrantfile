Vagrant.configure("2") do |config|

  # BASE BOX

  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = false
  config.vm.boot_timeout = 600

  
  # MONITORING VM

  config.vm.define "monitoring" do |mon|

    mon.vm.hostname = "monitoring"

    # NETWORK (NO BRIDGE)
    
    mon.vm.network "private_network", ip: "192.168.56.20"

    
    # VIRTUALBOX SETTINGS
    
    mon.vm.provider "virtualbox" do |vb|
      vb.name = "monitoring"
      vb.memory = 2048
      vb.cpus = 2
      vb.gui = false
    end

    # Fix /vagrant missing issue
    mon.vm.synced_folder ".", "/vagrant"

    # Ansible folder
    mon.vm.synced_folder "./ansible", "/ansible", type: "virtualbox"

    # INSTALL ANSIBLE

    mon.vm.provision "shell", inline: <<-SHELL
      apt-get update -y
      apt-get install -y ansible
    SHELL

    # ANSIBLE PROVISION

    mon.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "/ansible/playbook.yml"
      ansible.install = false

      # FIX Ansible version detection
      ansible.compatibility_mode = "2.0"

      ansible.extra_vars = {
        vm_role: "monitoring"
      }
    end

  end
end
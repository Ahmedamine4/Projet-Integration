generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  utilisateur_id   String          @id @default(cuid())
  nom              String          @db.VarChar(50)
  prenom           String          @db.VarChar(50)
  supabase_uid     String?         @unique
  provider         String?         @default("local")
  role             RoleUtilisateur
  email            String          @unique @db.VarChar(100)
  mot_de_passe     String?         @db.VarChar(255)
  telephone        String?         @db.VarChar(20)
  date_de_creation DateTime?       @default(now())
  administrateur   Administrateur?
  connexions       Connexion[]
  directeur        Directeur?
  etudiant         Etudiant?
  interactions     Interaction[]
  notifications    Notification[]
  professeur       Professeur?
  professionnel    Professionnel?

  @@map("utilisateurs")
}

model Administrateur {
  admin_utilisateur_id   String          @id
  niveau_acces           String?         @db.VarChar(50)
  utilisateur            Utilisateur     @relation(fields: [admin_utilisateur_id], references: [utilisateur_id])
  professionnels_valides Professionnel[] @relation("AdminValidation")

  @@map("administrateurs")
}

model Directeur {
  directeur_utilisateur_id String      @id
  poste                    String?     @db.VarChar(100)
  bureau                   String?     @db.VarChar(50)
  institution_id           String      @unique
  utilisateur              Utilisateur @relation(fields: [directeur_utilisateur_id], references: [utilisateur_id])
  institution              Institution @relation(fields: [institution_id], references: [institution_id])

  @@map("directeurs")
}

model Etudiant {
  etudiant_utilisateur_id String                     @id
  promotion               String?                    @db.VarChar(50)
  niveau                  String?                    @db.VarChar(50)
  github_API              String?
  utilisateur             Utilisateur                @relation(fields: [etudiant_utilisateur_id], references: [utilisateur_id])
  experiences             Experience[]
  recommandations         LettresDeRecommendations[]
  portfolio               Portfolio?
  repositories            repositories[]
  institutions            ValideEtudiant[]
  badges                  Badge[]                    @relation("BadgeToEtudiant")
  clubs                   Club[]                     @relation("ClubToEtudiant")

  @@map("etudiants")
}

model Professeur {
  prof_utilisateur_id     String                     @id
  departement             String?                    @db.VarChar(50)
  specialite              String?                    @db.VarChar(50)
  lettres_recommandations LettresDeRecommendations[]
  utilisateur             Utilisateur                @relation(fields: [prof_utilisateur_id], references: [utilisateur_id])
  projets                 ValideProjet[]
  stages                  ValideStage[]
  institutions            Institution[]              @relation("InstitutionToProfesseur")

  @@map("professeurs")
}

model Professionnel {
  professionnel_utilisateur_id String            @id
  entreprise                   String?           @db.VarChar(100)
  post                         String?           @db.VarChar(50)
  email_professionnel          String?           @db.VarChar(100)
  statut                       StatutValidation?
  admin_id                     String?
  admin                        Administrateur?   @relation("AdminValidation", fields: [admin_id], references: [admin_utilisateur_id])
  utilisateur                  Utilisateur       @relation(fields: [professionnel_utilisateur_id], references: [utilisateur_id])

  @@map("professionnels")
}

model Club {
  club_id       String        @id @default(cuid())
  nom           String?       @db.VarChar(50)
  description   String?
  date_creation DateTime?
  responsable   String?       @db.VarChar(50)
  activites     Activite[]    @relation("ActiviteToClub")
  etudiants     Etudiant[]    @relation("ClubToEtudiant")
  institutions  Institution[] @relation("ClubToInstitution")

  @@map("clubs")
}

model Badge {
  badge_id    String     @id @default(cuid())
  nom         String?    @db.VarChar(50)
  icone       String?
  score       Int?
  description String?
  etudiants   Etudiant[] @relation("BadgeToEtudiant")

  @@map("badges")
}

model Competence {
  competence_id String       @id @default(cuid())
  type          String?      @db.VarChar(50)
  nom           String?      @db.VarChar(50)
  description   String?
  niveau        String?      @db.VarChar(50)
  experiences   Experience[] @relation("CompetenceToExperience")

  @@map("competences")
}

model Portfolio {
  portfolio_id      String        @id @default(cuid())
  titre             String?       @db.VarChar(100)
  objectif_cible    String?       @db.VarChar(100)
  visibilite        Boolean?
  date_generation   DateTime?
  score_credibilite Int?
  utilisateur_id    String        @unique
  interactions      Interaction[]
  etudiant          Etudiant      @relation(fields: [utilisateur_id], references: [etudiant_utilisateur_id])

  @@map("portfolio")
}

model Notification {
  notification_id   String      @id @default(cuid())
  message           String?
  date_notification DateTime?
  lu                Boolean?
  type              String?     @db.VarChar(50)
  utilisateur_id    String
  utilisateur       Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])

  @@map("notifications")
}

model Connexion {
  connexion_id      String      @id @default(cuid())
  ip_address        String?     @db.VarChar(50)
  statut            Boolean?
  date_de_connexion DateTime?
  utilisateur_id    String
  utilisateur       Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id])

  @@map("connexions")
}

model Institution {
  institution_id String                @id @default(cuid())
  nom            String                @db.VarChar(50)
  address        String?               @db.VarChar(50)
  email          String                @db.VarChar(255)
  description    String?
  directeur      Directeur?
  activites      ValideActivite[]
  certifications ValideCertification[]
  etudiants      ValideEtudiant[]
  clubs          Club[]                @relation("ClubToInstitution")
  professeurs    Professeur[]          @relation("InstitutionToProfesseur")

  @@map("institutions")
}

model Experience {
  experience_id   String          @id @default(cuid())
  titre           String?         @db.VarChar(100)
  date_experience DateTime?
  visibilite      Boolean?
  type            TypeExperience
  description     String?
  utilisateur_id  String
  activite        Activite?
  certification   Certification?
  documentations  Documentation[]
  etudiant        Etudiant        @relation(fields: [utilisateur_id], references: [etudiant_utilisateur_id])
  interactions    Interaction[]
  projet          Projet?
  stage           Stage?
  competences     Competence[]    @relation("CompetenceToExperience")

  @@map("experiences")
}

model Certification {
  experience_id String               @id
  document      String?
  lien_URL      String?
  code          String?
  experience    Experience           @relation(fields: [experience_id], references: [experience_id])
  validation    ValideCertification?

  @@map("certifications")
}

model Documentation {
  documentation_id String     @id @default(cuid())
  captures         String?
  pdf              String?
  experience_id    String
  experience       Experience @relation(fields: [experience_id], references: [experience_id])

  @@map("documentations")
}

model Projet {
  experience_id    String        @id
  type_projet      String?       @db.VarChar(50)
  lien_github      String?
  lien_youtube     String?
  resultat_obtenus String?
  role             String?       @db.VarChar(50)
  experience       Experience    @relation(fields: [experience_id], references: [experience_id])
  validation       ValideProjet?

  @@map("projets")
}

model Activite {
  experience_id String          @id
  type          String?         @db.VarChar(50)
  lieu          String?         @db.VarChar(100)
  experience    Experience      @relation(fields: [experience_id], references: [experience_id])
  validation    ValideActivite?
  clubs         Club[]          @relation("ActiviteToClub")

  @@map("activites")
}

model Stage {
  experience_id      String       @id
  duree              String?      @db.VarChar(50)
  missions_realisees String?
  rapport_stage      String?
  experience         Experience   @relation(fields: [experience_id], references: [experience_id])
  validation         ValideStage?

  @@map("stages")
}

model Interaction {
  interaction_id   String            @id @default(cuid())
  type             String?           @db.VarChar(50)
  texte            String?
  statut           StatutValidation?
  date_interaction DateTime?
  portfolio_id     String?
  experience_id    String?
  utilisateur_id   String
  experience       Experience?       @relation(fields: [experience_id], references: [experience_id])
  portfolio        Portfolio?        @relation(fields: [portfolio_id], references: [portfolio_id])
  utilisateur      Utilisateur       @relation(fields: [utilisateur_id], references: [utilisateur_id])

  @@map("interactions")
}

model LettresDeRecommendations {
  utilisateur_id      String
  prof_utilisateur_id String
  type_candidature    String?           @db.VarChar(50)
  fichier             String?
  statut              StatutValidation?
  date_lettre         DateTime?
  commentaire         String?
  professeur          Professeur        @relation(fields: [prof_utilisateur_id], references: [prof_utilisateur_id])
  etudiant            Etudiant          @relation(fields: [utilisateur_id], references: [etudiant_utilisateur_id])

  @@id([utilisateur_id, prof_utilisateur_id])
  @@map("lettres_de_recommendations")
}

model ValideActivite {
  experience_id  String            @unique
  institution_id String
  statut         StatutValidation?
  date_d_action  DateTime?
  commentaire    String?
  activite       Activite          @relation(fields: [experience_id], references: [experience_id])
  institution    Institution       @relation(fields: [institution_id], references: [institution_id])

  @@id([experience_id, institution_id])
  @@map("valide_activite")
}

model ValideProjet {
  experience_id  String            @unique
  utilisateur_id String
  statut         StatutValidation?
  date_d_action  DateTime?
  commentaire    String?
  projet         Projet            @relation(fields: [experience_id], references: [experience_id])
  professeur     Professeur        @relation(fields: [utilisateur_id], references: [prof_utilisateur_id])

  @@id([experience_id, utilisateur_id])
  @@map("valide_projet")
}

model ValideStage {
  utilisateur_id String
  experience_id  String            @unique
  statut         StatutValidation?
  date_d_action  DateTime?
  commentaire    String?
  stage          Stage             @relation(fields: [experience_id], references: [experience_id])
  professeur     Professeur        @relation(fields: [utilisateur_id], references: [prof_utilisateur_id])

  @@id([utilisateur_id, experience_id])
  @@map("valide_stage")
}

model ValideCertification {
  institution_id String
  experience_id  String            @unique
  statut         StatutValidation?
  date_d_action  DateTime?
  commentaire    String?
  certification  Certification     @relation(fields: [experience_id], references: [experience_id])
  institution    Institution       @relation(fields: [institution_id], references: [institution_id])

  @@id([institution_id, experience_id])
  @@map("valide_certification")
}

model ValideEtudiant {
  utilisateur_id String
  institution_id String
  statut         StatutValidation?
  date_d_action  DateTime?
  institution    Institution       @relation(fields: [institution_id], references: [institution_id])
  etudiant       Etudiant          @relation(fields: [utilisateur_id], references: [etudiant_utilisateur_id])

  @@id([utilisateur_id, institution_id])
  @@map("valide_etudiant")
}

model repositories {
  repository_id       String   @id
  github_id           Int      @unique
  etudiant_id         String
  name                String
  full_name           String
  description         String?
  html_url            String
  language            String?
  stars               Int      @default(0)
  forks               Int      @default(0)
  is_private          Boolean  @default(false)
  github_access_token String?
  last_synced         DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime
  etudiants           Etudiant @relation(fields: [etudiant_id], references: [etudiant_utilisateur_id])
}

enum TypeExperience {
  certification
  projet
  stage
  activite
}

enum RoleUtilisateur {
  etudiant
  professeur
  administrateur
  professionnel
  directeur
}

enum StatutValidation {
  en_attente
  valide
  refuse
}

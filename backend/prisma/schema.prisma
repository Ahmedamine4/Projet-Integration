// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum TypeCompetence {
  technologie
  domaine
}

enum ActionSession {
LOGIN
LOGOUT
}

enum TypeExperience {
  certification
  projet
  stage
  activite
}

enum TypeSpecifique {
  personnel
  academique
}

enum RoleUtilisateur {
  etudiant
  professeur
  administrateur
  professionnel
  directeur
}

enum StatutValidation {
  en_attente
  valide
  refuse
}

// UTILISATEURS ET HERITAGES

model Utilisateur {
  utilisateur_id   String          @id @default(cuid())
  nom              String          @db.VarChar(50)
  prenom           String          @db.VarChar(50)
  photo            String?
  supabase_uid     String?         @unique
  provider         String?         @default("local")
  bloque           Boolean?        @default(false)
  role             RoleUtilisateur
  email            String          @unique @db.VarChar(100)
  mot_de_passe     String?         @db.VarChar(255)
  telephone        String?         @db.VarChar(20)
  a_propos         String?
  date_de_creation DateTime?       @default(now())
  github           String?
  instagram        String?
  x                String?
  linkedin         String?

  // Relations d'héritage (1-to-1)
  administrateur Administrateur?
  directeur      Directeur?
  etudiant       Etudiant?
  professeur     Professeur?
  professionnel  Professionnel?

  // Autres relations
  notifications_recues Notification[] @relation("NotificationCible")
  notifications_envoyees Notification[] @relation("NotificationSource")
  connexions    Connexion[]
  interactions  Interaction[]
  following  Follow[] @relation("UserFollowing")
  followers  Follow[] @relation("UserFollowers")

  @@map("utilisateurs")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    Utilisateur @relation("UserFollowers", fields: [followerId], references: [utilisateur_id], onDelete: Cascade)
  following   Utilisateur @relation("UserFollowing", fields: [followingId], references: [utilisateur_id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model Administrateur {
  admin_utilisateur_id String  @id
  niveau_acces         String? @db.VarChar(50)

  utilisateur            Utilisateur     @relation(fields: [admin_utilisateur_id], references: [utilisateur_id], onDelete: Cascade)
  professionnels_valides Professionnel[] @relation("AdminValidation")

  @@map("administrateurs")
}

model Directeur {
  directeur_utilisateur_id String  @id
  poste                    String? @db.VarChar(100)
  bureau                   String? @db.VarChar(50)

  institution_id String @unique

  utilisateur Utilisateur @relation(fields: [directeur_utilisateur_id], references: [utilisateur_id], onDelete: Cascade)
  institution Institution @relation(fields: [institution_id], references: [institution_id], onDelete: Cascade)

  @@map("directeurs")
}

model Etudiant {
  etudiant_utilisateur_id String                     @id
  promotion               String?                    @db.VarChar(50)
  niveau                  String?                    @db.VarChar(50)
  etudie                  Boolean?
  github_API              String?
  repositories            Repository[]
  utilisateur             Utilisateur                @relation(fields: [etudiant_utilisateur_id], references: [utilisateur_id], onDelete: Cascade)
  portfolio               Portfolio?
  experiences             Experience[]
  clubs                   Club[]
  institutions            ValideEtudiant[]
  badges                  Badge[]
  recommandations         LettresDeRecommendations[]

  @@map("etudiants")
}

model Professeur {
  prof_utilisateur_id String  @id
  departement         String? @db.VarChar(50)
  specialite          String? @db.VarChar(50)

  utilisateur             Utilisateur                @relation(fields: [prof_utilisateur_id], references: [utilisateur_id], onDelete: Cascade)
  lettres_recommandations LettresDeRecommendations[]
  institutions            Institution[]
  projets                 ValideProjet[]
  stages                  ValideStage[]

  @@map("professeurs")
}

model Professionnel {
  professionnel_utilisateur_id String            @id
  entreprise                   String?           @db.VarChar(100)
  poste                        String?           @db.VarChar(50)
  email_professionnel          String?           @db.VarChar(100)
  statut                       StatutValidation?
  admin_id                     String?

  utilisateur Utilisateur     @relation(fields: [professionnel_utilisateur_id], references: [utilisateur_id], onDelete: Cascade)
  admin       Administrateur? @relation("AdminValidation", fields: [admin_id], references: [admin_utilisateur_id], onDelete: SetNull)

  @@map("professionnels")
}

// ENTITÉS PRINCIPALES

model Club {
  club_id       String        @id @default(cuid())
  nom           String?       @db.VarChar(50)
  description   String?
  date_creation DateTime?
  responsable   String?       @db.VarChar(50)
  etudiants     Etudiant[]
  institutions  Institution[]
  activites     Activite[]

  @@map("clubs")
}

model Badge {
  badge_id    String     @id @default(cuid())
  nom         String?    @db.VarChar(50)
  icone       String?
  score       Int?
  description String?
  etudiants   Etudiant[]

  @@map("badges")
}

model Competence {
  competence_id         String       @id @default(cuid())
  type                  TypeCompetence
  nom                   String?      @db.VarChar(50)
  description           String?
  competence_dev        CompetenceDeveloppee[]

  @@map("competences")
}

model Portfolio {
  portfolio_id      String        @id @default(cuid())
  titre             String?       @db.VarChar(100)
  objectif_cible    String?       @db.VarChar(100)
  visibilite        Boolean?
  date_generation   DateTime?
  score_credibilite Int?
  utilisateur_id    String        @unique
  etudiant          Etudiant      @relation(fields: [utilisateur_id], references: [etudiant_utilisateur_id], onDelete: Cascade)
  interactions      Interaction[]
  history           PortfolioScoreHistory[]

  @@map("portfolio")
}

model PortfolioScoreHistory {
  history_id    String   @id @default(cuid())
  portfolio_id  String
  score         Int
  breakdown     Json?
  date          DateTime @default(now())
  portfolio     Portfolio @relation(fields: [portfolio_id], references: [portfolio_id], onDelete: Cascade)

  @@map("portfolio_score_history")
}

model Notification {
  notification_id       String @id @default(cuid())
  message               String?
  date_notification     DateTime?
  lu                    Boolean?
  type                  String?

  utilisateur_cible_id  String
  utilisateur_source_id String?

  utilisateur_cible Utilisateur @relation("NotificationCible", fields: [utilisateur_cible_id], references: [utilisateur_id], onDelete: Cascade)
  utilisateur_source Utilisateur? @relation("NotificationSource", fields: [utilisateur_source_id], references: [utilisateur_id], onDelete: SetNull)
}

model Connexion {
  connexion_id    String      @id @default(cuid())
  utilisateur_id  String
  session_token   String      @unique
  browser         String?
  browser_version String?
  device_type     String?
  os              String?
  ip              String?
  ville           String?
  pays            String?
  is_current      Boolean     @default(false)
  date_connexion  DateTime    @default(now())
  last_active     DateTime    @default(now())
  expires_at      DateTime

  utilisateur     Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id], onDelete: Cascade)

  @@map("connexions")
}

model Institution {
  institution_id String  @id @default(cuid())
  nom            String  @db.VarChar(50)
  addresse       String? @db.VarChar(50)
  email          String  @db.VarChar(255)
  description    String?
  academique     Boolean?

  directeur      Directeur[]
  clubs          Club[]
  professeurs    Professeur[]
  activites      ValideActivite[]
  etudiants      ValideEtudiant[]
  certifications Certification[]

  @@map("institutions")
}

// EXPERIENCES ET HERITAGES

model Experience {
  experience_id   String          @id @default(cuid())
  titre           String?         @db.VarChar(100)
  date_experience DateTime?
  visibilite      Boolean?
  type            TypeExperience
  type_specifique TypeSpecifique?
  description     String?
  photo           String?
  deleted_at      DateTime?
  is_draft        Boolean    @default(false)
  technologies_locked  Boolean    @default(false)
  utilisateur_id  String

  etudiant      Etudiant       @relation(fields: [utilisateur_id], references: [etudiant_utilisateur_id], onDelete: Cascade)
  certification Certification?
  projet        Projet?
  activite      Activite?
  stage         Stage?

  interactions      Interaction[]
  competence_dev    CompetenceDeveloppee[]

  @@map("experiences")
}

model Certification {
  experience_id String               @id
  document      String?
  lien_URL      String?
  code          String?
  institution_id String?
  institution    Institution? @relation(fields: [institution_id], references: [institution_id])
  experience    Experience           @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade)

  @@map("certifications")
}


model Projet {
  experience_id        String      @id
  repository_id        String?     @unique
  lien_github          String?
  lien_youtube         String?
  resultat_obtenu      String?
  experience           Experience  @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade)
  repository           Repository? @relation(fields: [repository_id], references: [repository_id], onDelete: SetNull)
  validation           ValideProjet?

  @@map("projets")
}
model Activite {
  experience_id String          @id
  type          String?         @db.VarChar(50)
  lieu          String?         @db.VarChar(100)
  experience    Experience      @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade)
  validation    ValideActivite?
  clubs         Club[]

  @@map("activites")
}

model Stage {
  experience_id      String       @id
  date_fin           DateTime?
  duree              String?      @db.VarChar(50)
  missions_realisees String?
  rapport_stage      String?
  experience         Experience   @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade)
  validation         ValideStage?

  @@map("stages")
}

model Interaction {
  interaction_id   String            @id @default(cuid())
  type             String?           @db.VarChar(50)
  texte            String?
  visibilite       Boolean   @default(false)
  date_interaction DateTime?
  portfolio_id     String?
  experience_id    String?
  utilisateur_id   String

  portfolio   Portfolio?  @relation(fields: [portfolio_id], references: [portfolio_id], onDelete: Cascade)
  experience  Experience? @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [utilisateur_id], onDelete: Cascade)

  @@map("interactions")
}

// TABLES DE JONCTION (Relations Many-to-Many)

model LettresDeRecommendations {
  utilisateur_id      String
  prof_utilisateur_id String
  objet               String?              @db.VarChar(255)
  description         String?
  fichier             String?
  statut              StatutValidation?    @default(en_attente)
  date_lettre         DateTime?            @default(now())
  commentaire         String?

  etudiant   Etudiant   @relation(fields: [utilisateur_id], references: [etudiant_utilisateur_id], onDelete: Cascade)
  professeur Professeur @relation(fields: [prof_utilisateur_id], references: [prof_utilisateur_id], onDelete: Cascade)

  @@id([utilisateur_id, prof_utilisateur_id])
  @@map("lettres_de_recommendations")
}

model CompetenceDeveloppee {
  experience_id String
  competence_id String
  niveau        String?

  experience    Experience @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade)
  competence    Competence @relation(fields: [competence_id], references: [competence_id], onDelete: Cascade)

  @@id([experience_id, competence_id])
  @@map("Competences_Developpees")
}

model ValideActivite {
  experience_id  String            @unique
  institution_id String
  statut         StatutValidation?
  date_d_action  DateTime?
  commentaire    String?
  activite       Activite          @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade)
  institution    Institution       @relation(fields: [institution_id], references: [institution_id], onDelete: Cascade)

  @@id([experience_id, institution_id])
  @@map("valide_activite")
}

model ValideProjet {
  experience_id  String            @unique
  utilisateur_id String
  statut         StatutValidation?
  date_d_action  DateTime?
  commentaire    String?

  projet     Projet     @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade)
  professeur Professeur @relation(fields: [utilisateur_id], references: [prof_utilisateur_id], onDelete: Cascade)

  @@id([experience_id, utilisateur_id])
  @@map("valide_projet")
}

model ValideStage {
  utilisateur_id String
  experience_id  String            @unique
  statut         StatutValidation?
  date_d_action  DateTime?
  commentaire    String?

  professeur Professeur @relation(fields: [utilisateur_id], references: [prof_utilisateur_id], onDelete: Cascade)
  stage      Stage      @relation(fields: [experience_id], references: [experience_id], onDelete: Cascade)

  @@id([utilisateur_id, experience_id])
  @@map("valide_stage")
}

model ValideEtudiant {
  utilisateur_id String
  institution_id String
  statut         StatutValidation?
  date_debut           DateTime?
  date_fin             DateTime?
  description    String?
  niveau         String?

  etudiant    Etudiant    @relation(fields: [utilisateur_id], references: [etudiant_utilisateur_id], onDelete: Cascade)
  institution Institution @relation(fields: [institution_id], references: [institution_id], onDelete: Cascade)

  @@id([utilisateur_id, institution_id])
  @@map("valide_etudiant")
}

model Repository {
  repository_id       String   @id @default(cuid())
  github_id           Int      @unique
  etudiant_id         String
  title               String
  description         String?
  link                String
  language            String?
  stars               Int      @default(0)
  forks               Int      @default(0)
  private             Boolean  @default(false)
  github_access_token String?
  last_synced         DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  etudiant            Etudiant @relation(fields: [etudiant_id], references: [etudiant_utilisateur_id], onDelete: Cascade)
  projets             Projet[]

  @@map("repositories")
}

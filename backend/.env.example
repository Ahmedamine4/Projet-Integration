# Variables de PostgreSQL
DB_USER=votre_utilisateur_db
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nom_de_votre_base_de_donnees

# Prisma URL
# Remplacez les valeurs par celles de vos variables PostgreSQL ci-dessus
DATABASE_URL="postgresql://votre_utilisateur_db:votre_mot_de_passe@localhost:5432/nom_de_votre_base_de_donnees?schema=public"

# Port for the Express server
PORT=3000